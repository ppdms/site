{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "gallerydeluxe"
  ],
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && tsx scripts/check-assets.ts",
    "build:astro": "astro build && tsx scripts/check-assets.ts",
    "types": "wrangler types worker-configuration.d.ts",
    "check": "astro check && tsc --noEmit -p tsconfig.worker.json",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:media": "tsx --test scripts/media.test.ts",
    "preview:worker": "wrangler dev --local --port 8787",
    "deploy": "npm run build && wrangler deploy --env production --minify",
    "deploy:preview": "npm run build && wrangler deploy --env=\"\" --minify",
    "gallery:add": "tsx scripts/add-gallery-photos.ts",
    "gallery:migrate": "tsx scripts/migrate-gallery.ts",
    "backlinks:titles": "tsx scripts/format-links.ts"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@ppdms/gallerydeluxe": "*",
    "bootstrap-icons": "1.13.1",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/rss": "4.0.19",
    "@cloudflare/vitest-plugin": "1.1.4",
    "@cloudflare/workers-types": "5.20260904.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.13.3",
    "astro": "7.3.1",
    "exifr": "7.1.3",
    "puppeteer": "25.10.0",
    "rehype-raw": "7.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "0.35.4",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "vitest": "4.1.11",
    "wrangler": "4.129.0",
    "yaml": "2.9.0"
  }
}
