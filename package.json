{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && bun scripts/check-assets.ts",
    "build:astro": "astro build && bun scripts/check-assets.ts",
    "types": "cf workers types",
    "check": "astro check && tsc --noEmit -p tsconfig.worker.json",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:media": "bun test scripts/media.test.ts scripts/gallery-mosaic.test.ts scripts/gallery-labels.test.ts scripts/gallery-layout.test.ts",
    "test:viewer": "bun test scripts/viewer-sources.test.ts",
    "preview:worker": "cf dev",
    "deploy": "bun run build && CLOUDFLARE_AUTH_USE_KEYRING=true cf deploy",
    "deploy:preview": "bun run build && CLOUDFLARE_AUTH_USE_KEYRING=true cf deploy --mode preview",
    "gallery:add": "bun scripts/add-gallery-photos.ts",
    "gallery:migrate": "bun scripts/migrate-gallery.ts",
    "gallery:mosaic": "bun scripts/generate-gallery-mosaic.ts",
    "backlinks:titles": "bun scripts/format-links.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@phosphor-icons/core": "^2.1.1",
    "bootstrap-icons": "1.13.2",
    "maplibre-gl": "6.19.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/cloudflare": "^15.0.0-beta.6",
    "@astrojs/markdown-remark": "7.3.10",
    "@astrojs/rss": "4.0.19",
    "@cloudflare/vitest-plugin": "1.9.0",
    "@cloudflare/workers-types": "5.20261121.1",
    "@types/node": "26.6.6",
    "astro": "^7.4.13",
    "cf": "^1.0.0-rc.2",
    "esbuild": "^0.28.2",
    "exifr": "7.1.3",
    "hast-util-from-html": "2.1.0",
    "hast-util-to-html": "9.0.7",
    "puppeteer": "25.18.1",
    "rehype-raw": "7.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "vite": "^8.3.8",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
