---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import PostList from "../../components/PostList.astro";

export async function getStaticPaths() {
  const posts: CollectionEntry<"posts">[] = await getCollection("posts");
  const visiblePosts = posts.filter((post) => !post.data.draft);
  const categories = new Set(visiblePosts.flatMap((post) => post.data.categories));
  return [...categories].map((category) => ({
    params: { category },
    props: { category, posts: visiblePosts.filter((post) => post.data.categories.includes(category)) },
  }));
}

interface Props {
  category: string;
  posts: CollectionEntry<"posts">[];
}

const { category, posts } = Astro.props;
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<SiteLayout title={`Category: ${category}`} description={`Posts in the ${category} category.`}>
  <section class="taxonomy-page">
    <h1>Category: {category}</h1>
    <PostList posts={posts} />
  </section>
</SiteLayout>
