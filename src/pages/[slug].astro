---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import PostHeader from "../components/PostHeader.astro";
import PhotoGrid from "../components/PhotoGrid.astro";

export async function getStaticPaths() {
  const posts: CollectionEntry<"posts">[] = await getCollection("posts");
  const visiblePosts = posts.filter((post) => !post.data.draft);
  const seenSlugs = new Set<string>();
  for (const post of visiblePosts) {
    if (seenSlugs.has(post.data.slug)) {
      throw new Error(`Duplicate post slug: ${post.data.slug}`);
    }
    seenSlugs.add(post.data.slug);
  }
  return visiblePosts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { Content } = await render(post);

const isTravel = post.data.type === "travel";
const travelFolders: Record<string, string> = {
  denmark: "denmark",
  portugal: "portugal",
  "postcards-from-italy": "rome",
  "kefalonia-in-may": "kefalonia",
  "norway-denmark": "scandinavia",
};
const travelFolder = isTravel ? travelFolders[post.data.slug] : undefined;
if (isTravel && !travelFolder) {
  throw new Error(`No travel image folder configured for ${post.data.slug}`);
}
---

<SiteLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  wide={isTravel}
>
  <article class="post-article">
    <PostHeader
      title={post.data.title}
      description={post.data.description}
      date={post.data.date}
      type={post.data.type}
      author={post.data.author}
    />

    <div class="prose">
      <Content />
    </div>

    {isTravel && travelFolder && (
      <PhotoGrid
        folder={travelFolder}
        photoCaptions={post.data.photo_captions}
        captions={post.data.captions}
        alts={post.data.alts}
      />
    )}
  </article>
</SiteLayout>

<style>
  .post-article {
    width: 100%;
  }
</style>
