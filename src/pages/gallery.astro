---
import { parseManifest } from "@ppdms/gallerydeluxe/types";
import type { GalleryManifest, Photo } from "@ppdms/gallerydeluxe/types";
import { renderGalleryShells, renderViewerData } from "@ppdms/gallerydeluxe/shells";
import galleryManifestSource from "../data/gallery.json?raw";
import sheetRuntimeSource from "virtual:gallery-sheet";
import SiteLayout from "../layouts/SiteLayout.astro";
import PhotoViewer from "../components/PhotoViewer.astro";
import "../styles/gallery.css";

const manifest: GalleryManifest = parseManifest(JSON.parse(galleryManifestSource));

// Emitted in manifest order; the arrangement for a given visit is chosen in the
// browser by the inline sheet runtime below, before the first paint.
const photos: Photo[] = manifest.images;
---

<SiteLayout
  title="Gallery"
  description="A contact sheet of photographs by Basil Papadimas."
  isGallery={true}
>
  <section id="gallery-page" aria-labelledby="gallery-heading">
    <h1 id="gallery-heading" class="sr-only">Gallery</h1>
    {photos.length === 0 ? (
      <p class="gd-empty">No photographs yet.</p>
    ) : (
      <div id="gallerydeluxe" class="gd-contact-sheet">
        <div class="gd-photo-list" set:html={renderGalleryShells(photos)} />
      </div>
    )}
    <!-- Runs the moment the sheet above has been parsed, so the cells are
         never shown in an arrangement the visitor will not keep. -->
    <script is:inline set:html={sheetRuntimeSource}></script>
    <PhotoViewer id="gd-viewer" />
    <script
      is:inline
      type="application/json"
      id="gd-viewer-data"
      set:html={renderViewerData(photos)}
    />
  </section>
</SiteLayout>

<script>
  import { watchGalleryImages } from "@ppdms/gallerydeluxe/runtime";
  import { openDeepLinkedPhoto } from "@ppdms/gallerydeluxe/gallery";
  import { readGalleryPhotos } from "@ppdms/gallerydeluxe/shells";
  import { createViewer } from "@ppdms/gallerydeluxe/viewer";

  const container = document.getElementById("gallerydeluxe");
  const dialog = document.getElementById("gd-viewer");
  const dataElement = document.getElementById("gd-viewer-data");

  if (container && dialog instanceof HTMLDialogElement && dataElement) {
    watchGalleryImages(container);

    // The inline runtime has arranged the sheet by now, so DOM order is the
    // order the visitor browses in.
    const photos = readGalleryPhotos(container, dataElement.textContent || "[]");
    const viewer = createViewer(dialog, photos, {
      syncImageQuery: true,
      enableExif: true,
    });

    for (const link of container.querySelectorAll<HTMLAnchorElement>(".gd-photo-shell")) {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        const id = link.closest<HTMLElement>(".gd-photo-item")?.dataset.id;
        if (id) viewer.open(id, link);
      });
    }

    container.setAttribute("data-gd-viewer", "");
    openDeepLinkedPhoto(container, viewer, photos);
  }
</script>
