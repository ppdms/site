---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

const posts: CollectionEntry<"posts">[] = await getCollection("posts");
const visiblePosts = posts.filter((post) => !post.data.draft);
const tags = new Map<string, number>();
for (const post of visiblePosts) {
  for (const tag of post.data.tags) {
    tags.set(tag, (tags.get(tag) || 0) + 1);
  }
}
const sortedTags = [...tags.entries()].sort(([a], [b]) => a.localeCompare(b));
---

<SiteLayout title="Tags" description="Posts by tag.">
  <section class="taxonomy-page">
    <h1>Tags</h1>
    {sortedTags.length > 0 ? (
      <ul class="taxonomy-list">
        {sortedTags.map(([tag, count]) => (
          <li>
            <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
            <span>{count}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="taxonomy-empty">
        No tags yet. <a href="/posts/">See all posts.</a>
      </p>
    )}
  </section>
</SiteLayout>

<style>
  .taxonomy-page h1 {
    margin-bottom: var(--space-6);
  }

  .taxonomy-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    list-style: none;
    max-width: 36rem;
  }

  .taxonomy-list li {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-2);
  }

  .taxonomy-list a {
    color: var(--accent);
  }

  .taxonomy-list span,
  .taxonomy-empty {
    color: var(--muted);
  }

  .taxonomy-empty a {
    color: var(--accent);
  }
</style>
