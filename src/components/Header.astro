---
const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const isBacklinks = pathname.startsWith("/backlinks");
const isGallery = pathname.startsWith("/gallery");
---

<header id="banner">
  <div id="banner-inner">
    <div id="banner-identity">
      <a id="site-title" href="/">Basil Papadimas</a>
    </div>
    <nav id="toolbar" aria-label="Main navigation">
      <ul>
        <li class:list={{ active: isHome }}>
          <a href="/" title="" data-text="Home" aria-current={isHome ? "page" : undefined}>Home</a>
        </li>
        <li class:list={{ active: isBacklinks }}>
          <a href="/backlinks/" title="" data-text="Backlinks" aria-current={isBacklinks ? "page" : undefined}>Backlinks</a>
        </li>
        <li class:list={{ active: isGallery }}>
          <a href="/gallery/" title="" data-text="Gallery" aria-current={isGallery ? "page" : undefined}>Gallery</a>
        </li>
      </ul>
      <button
        type="button"
        id="theme-toggle"
        aria-label="Toggle theme"
        data-mode="dark"
        title="Switch to light theme"
      >
        <svg class="tt-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
        </svg>
        <svg class="tt-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>
