---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import PhotoViewer from "./PhotoViewer.astro";

interface Props {
  folder: string;
  photoCaptions: boolean;
  captions?: Record<string, string>;
  alts?: Record<string, string>;
}

const { folder, photoCaptions, captions = {}, alts = {} } = Astro.props;

// Eager typed import.meta.glob over all travel images
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "../content/posts/**/*.{jpeg,jpg,JPG,JPEG}",
  { eager: true }
);

interface ImageMetadataWithClone extends ImageMetadata {
  readonly clone?: ImageMetadata;
  readonly fsPath?: string;
}

// Filter to images in the requested folder
const folderEntries: Array<{ filename: string; metadata: ImageMetadata }> = [];
for (const [path, mod] of Object.entries(allImages)) {
  const normalizedPath = path.replace(/\\/g, "/");
  const parts = normalizedPath.split("/");
  const fileFolder = parts[parts.length - 2];
  const filename = parts[parts.length - 1];

  if (fileFolder === folder) {
    const importedMetadata = mod.default as ImageMetadataWithClone;
    const metadata = importedMetadata.clone
      ? { ...importedMetadata.clone, fsPath: importedMetadata.fsPath }
      : importedMetadata;
    folderEntries.push({ filename, metadata });
  }
}

// Deterministic alphabetical sort (preserves "01-...", "02-...", etc.)
folderEntries.sort((a, b) => a.filename.localeCompare(b.filename));

const displayWidths = [480, 800, 1200, 1600];

// Process all images for grid and viewer
interface GridItem {
  filename: string;
  width: number;
  height: number;
  caption: string;
  alt: string;
  hasCaption: boolean;
  linkLabel: string;
  defaultSrc: string;
  srcset: string;
  fullViewSrc: string;
  sources: Array<{ src: string; width: number; height: number }>;
}

const gridItems: GridItem[] = await Promise.all(
  folderEntries.map(async ({ filename, metadata }, index) => {
    const caption = captions[filename] || "";
    const alt = Object.hasOwn(alts, filename) ? alts[filename] : caption;
    const hasCaption = Boolean(photoCaptions && caption);
    const linkLabel = caption || `View photograph ${index + 1} of ${folderEntries.length}`;

    const originalLongEdge = Math.max(metadata.width, metadata.height);
    const isLandscape = metadata.width >= metadata.height;
    const validLongEdges = displayWidths.filter((edge) => edge <= originalLongEdge);
    if (validLongEdges.length === 0) {
      validLongEdges.push(originalLongEdge);
    }

    const transformedSources = await Promise.all(
      validLongEdges.map(async (longEdge) => {
        const width = isLandscape
          ? Math.min(longEdge, metadata.width)
          : Math.max(1, Math.round((longEdge / metadata.height) * metadata.width));
        const img = await getImage({
          src: metadata,
          format: "webp",
          width,
        });
        const w = typeof img.attributes.width === "number" ? img.attributes.width : width;
        const h =
          typeof img.attributes.height === "number"
            ? img.attributes.height
            : Math.max(1, Math.round((w / metadata.width) * metadata.height));
        return {
          src: img.src,
          width: w,
          height: h,
        };
      })
    );

    // Full-view derivative capped to 2560px long edge
    const fullTargetWidth = isLandscape
      ? Math.min(2560, metadata.width)
      : Math.max(1, Math.round((Math.min(2560, originalLongEdge) / metadata.height) * metadata.width));
    const fullView = await getImage({
      src: metadata,
      format: "webp",
      width: fullTargetWidth,
    });

    const allSources = [...transformedSources];
    const fullViewWidth = typeof fullView.attributes.width === "number" ? fullView.attributes.width : fullTargetWidth;
    const fullViewHeight = typeof fullView.attributes.height === "number" ? fullView.attributes.height : Math.round((fullViewWidth / metadata.width) * metadata.height);

    if (!allSources.some((s) => s.width === fullViewWidth)) {
      allSources.push({
        src: fullView.src,
        width: fullViewWidth,
        height: fullViewHeight,
      });
    }

    allSources.sort((a, b) => a.width - b.width);

    const srcset = allSources.map((s) => `${s.src} ${s.width}w`).join(", ");
    const defaultSrc = allSources[0].src;

    return {
      filename,
      width: metadata.width,
      height: metadata.height,
      caption,
      alt,
      hasCaption,
      linkLabel,
      defaultSrc,
      srcset,
      fullViewSrc: fullView.src,
      sources: allSources,
    };
  })
);

// Photo payload for viewer controller
const viewerPhotos = gridItems.map((item) => ({
  id: item.filename,
  width: item.width,
  height: item.height,
  alt: item.alt,
  caption: item.caption || undefined,
  original: item.fullViewSrc,
  sources: item.sources,
}));
const viewerData = JSON.stringify(viewerPhotos).replaceAll("<", "\\u003c");
---

<div class="travel-gallery" data-folder={folder}>
  <div class="photo-grid">
    {gridItems.map((item, index) => {
      const isFirstRow = index < 2;
      const aspect = item.width / item.height;
      return (
        <figure style={`--ar: ${aspect}`}>
          <a
            href={item.fullViewSrc}
            aria-label={item.linkLabel}
            data-id={item.filename}
          >
            <img
              src={item.defaultSrc}
              srcset={item.srcset}
              sizes="(min-width: 60em) 45vw, (min-width: 43.75em) 48vw, 96vw"
              width={item.width}
              height={item.height}
              loading={isFirstRow ? "eager" : "lazy"}
              decoding="async"
              alt={item.alt}
            />
          </a>
          {item.hasCaption && <figcaption>{item.caption}</figcaption>}
        </figure>
      );
    })}
  </div>
  <PhotoViewer id={`viewer-${folder}`} />
  <script is:inline type="application/json" id={`viewer-data-${folder}`} set:html={viewerData}></script>
</div>

<script>
  import { createViewer } from "@ppdms/gallerydeluxe";
  import type { Photo } from "@ppdms/gallerydeluxe/types";
  import { computePhotoRows } from "@ppdms/gallerydeluxe/layout";

  const galleries = document.querySelectorAll<HTMLElement>(".travel-gallery");
  for (const gallery of galleries) {
    const folder = gallery.dataset.folder;
    if (!folder) continue;
    const dialog = document.getElementById(`viewer-${folder}`);
    const dataElement = document.getElementById(`viewer-data-${folder}`);
    if (!(dialog instanceof HTMLDialogElement) || !dataElement) continue;

    const viewerPhotos = JSON.parse(dataElement.textContent || "[]") as Photo[];
    const grid = gallery.querySelector<HTMLElement>(".photo-grid")!;
    const figures = Array.from(grid.querySelectorAll<HTMLElement>("figure"));
    const images = figures.map((figure) => figure.querySelector("img")!);
    const aspects = viewerPhotos.map((photo) => photo.width / photo.height);
    let rowEnds: number[] = [];

    const arrangeRows = (width: number): void => {
      const style = getComputedStyle(grid);
      const gap = parseFloat(style.columnGap);
      const rowLimit = Number(style.getPropertyValue("--row-limit"));
      const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
      const targetSize = Math.min(42 * rem, width / 2);
      const rows = computePhotoRows(aspects, width, gap, {
        targetArea: targetSize * targetSize,
        maxPhotos: Math.max(1, Math.min(rowLimit, Math.round((width + gap) / (22 * rem + gap)))),
      });
      if (rows.length === 0) return;

      if (rows.length !== rowEnds.length || rows.some((row, i) => row.end !== rowEnds[i])) {
        const focused = document.activeElement;
        const fragment = document.createDocumentFragment();
        for (const row of rows) {
          const element = document.createElement("div");
          element.className = "photo-row";
          for (let i = row.start; i < row.end; i++) element.append(figures[i]);
          fragment.append(element);
        }
        grid.replaceChildren(fragment);
        if (focused instanceof HTMLElement && grid.contains(focused)) {
          focused.focus({ preventScroll: true });
        }
        rowEnds = rows.map((row) => row.end);
      }

      for (const row of rows) {
        for (let i = row.start; i < row.end; i++) {
          images[i].sizes = `${row.height * aspects[i]}px`;
        }
      }
    };

    arrangeRows(grid.getBoundingClientRect().width);
    const gridObserver = new ResizeObserver(([entry]) => arrangeRows(entry.contentRect.width));
    gridObserver.observe(grid);

    const viewer = createViewer(dialog, viewerPhotos, {
      syncImageQuery: false,
      enableExif: false,
      downloadLabel: "Open full size",
    });

    const links = gallery.querySelectorAll<HTMLAnchorElement>("figure > a");
    links.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const id = link.getAttribute("data-id");
        if (id) {
          viewer.open(id, link);
        }
      });
    });
  }
</script>

<style>
  .travel-gallery {
    width: 100%;
  }
</style>
