---
import Header from "../components/Header.astro";
import "../styles/global.css";
import "../styles/prose.css";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  isGallery?: boolean;
  hasSidebar?: boolean;
  wide?: boolean;
}

const {
  title,
  description = "my home on the internet",
  type = "website",
  isGallery = false,
  hasSidebar = false,
  wide = false,
} = Astro.props;

const pageTitle = title ? `${title} — Basil Papadimas` : "Basil Papadimas";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || "https://papadim.as").toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="Basil Papadimas" href="/index.xml" />

    <!-- OpenGraph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Basil Papadimas" />

    <!-- Inline theme initialization to prevent flash of unstyled theme -->
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "dark" || (!t && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.setAttribute("data-theme", "dark");
        } else if (t === "light") {
          document.documentElement.setAttribute("data-theme", "light");
        }
      } catch {}
    </script>

    <!-- Deep-linked gallery photos start in the opaque lightbox, not the page shell. -->
    <script is:inline>
      try {
        const url = new URL(window.location.href);
        if (url.pathname.startsWith("/gallery/") && url.searchParams.has("image")) {
          document.documentElement.classList.add("gd-image-deep-link");
        }
      } catch {}
    </script>
    <style is:inline>
      html.gd-image-deep-link,
      html.gd-image-deep-link body {
        background: rgb(18, 18, 18);
      }

      html.gd-image-deep-link .skip-link,
      html.gd-image-deep-link #banner,
      html.gd-image-deep-link #layout,
      html.gd-image-deep-link #footer {
        visibility: hidden;
      }

      html.gd-image-deep-link #gd-viewer {
        visibility: visible;
      }
    </style>

    <!-- Cloudflare Web Analytics -->
    <script
      is:inline
      defer
      src="/analytics/b.js"
      data-cf-beacon='{"token": "47d06284daa047e88682a5dd2e516207"}'
    ></script>
  </head>
  <body>
    <a href="#content" class="skip-link">Skip to main content</a>
    <Header />
    <div id="layout" class:list={{ "has-sidebar": hasSidebar, "gallery-layout": isGallery }}>
      {hasSidebar && (
        <aside id="sidebar">
          <slot name="sidebar" />
        </aside>
      )}
      <main id="content" class:list={{ wide }}>
        <slot />
      </main>
    </div>
    <footer id="footer"></footer>

    <!-- External typed theme controller -->
    <script>
      function initThemeController(): void {
        const toggleBtn = document.getElementById("theme-toggle");
        if (!toggleBtn) return;

        function getEffectiveTheme(): "dark" | "light" {
          const currentAttr = document.documentElement.getAttribute("data-theme");
          if (currentAttr === "dark" || currentAttr === "light") {
            return currentAttr;
          }
          return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }

        function updateButtonLabel(): void {
          const effective = getEffectiveTheme();
          const next = effective === "dark" ? "light" : "dark";
          toggleBtn?.setAttribute("aria-label", `Switch to ${next} theme`);
          toggleBtn?.setAttribute("title", `Switch to ${next} theme`);
          toggleBtn?.setAttribute("data-mode", effective);
        }

        updateButtonLabel();

        toggleBtn.addEventListener("click", () => {
          const current = getEffectiveTheme();
          const next = current === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try {
            localStorage.setItem("theme", next);
          } catch {
            // Nonfatal storage error
          }
          updateButtonLabel();
        });

        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
          try {
            if (!localStorage.getItem("theme")) {
              document.documentElement.removeAttribute("data-theme");
              updateButtonLabel();
            }
          } catch {
            document.documentElement.removeAttribute("data-theme");
            updateButtonLabel();
          }
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initThemeController);
      } else {
        initThemeController();
      }
    </script>
  </body>
</html>
